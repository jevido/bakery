APP_NAME=Bakery
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

APP_URL=http://127.0.0.1:4910
APP_HOST=127.0.0.1
APP_PORT=4910

JWT_SECRET=

DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=4920
DB_DATABASE=bakery
DB_USERNAME=bakery
DB_PASSWORD=bakery

# Applications without a domain get <slug>.<suffix>.
BAKERY_DOMAIN_SUFFIX=localhost

# The domain the dashboard is served on through the proxy (/api/* to the API,
# the rest to the dashboard). Empty in development: Vite serves it on :4930.
BAKERY_DASHBOARD_DOMAIN=
BAKERY_DASHBOARD_API_UPSTREAM=bakery-api:4910
BAKERY_DASHBOARD_WEB_UPSTREAM=bakery-web:80

# Podman API socket; empty = $XDG_RUNTIME_DIR/podman/podman.sock.
BAKERY_PODMAN_SOCKET=
BAKERY_NETWORK=bakery

# The Caddy proxy container (bakery-proxy). On a real server: 80, 443 and
# BAKERY_PROXY_INTERNAL_TLS=false for ACME certificates.
BAKERY_PROXY_IMAGE=docker.io/library/caddy:2
# Publish on 127.0.0.1 in development; empty (all interfaces) on a server.
BAKERY_PROXY_BIND=127.0.0.1
BAKERY_PROXY_HTTP_PORT=4940
BAKERY_PROXY_HTTPS_PORT=4943
# How the API reaches Caddy's admin API, and the host address it is published
# on. On a server: http://bakery-proxy:2019 and empty (not published).
BAKERY_PROXY_ADMIN_URL=http://127.0.0.1:4949
BAKERY_PROXY_ADMIN_PUBLISH=127.0.0.1:4949
BAKERY_PROXY_INTERNAL_TLS=true

# ACME, used when BAKERY_PROXY_INTERNAL_TLS=false. Empty = Let's Encrypt with
# no account email. BAKERY_ACME_CA_ROOT: PEM file trusted for the CA's own
# HTTPS certificate (a private CA such as Pebble).
BAKERY_ACME_CA=
BAKERY_ACME_EMAIL=
BAKERY_ACME_CA_ROOT=
