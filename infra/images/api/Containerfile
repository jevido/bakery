# The Bakery API. Build from the repository root:
#   podman build -f infra/images/api/Containerfile -t localhost/bakery-api:dev .
# Runtime needs: the host user's Podman socket at /run/podman/podman.sock and
# the environment described in infra/prod/README.md.

FROM docker.io/library/golang:1.27 AS build
WORKDIR /src
COPY services/api/go.mod services/api/go.sum ./
RUN go mod download
COPY services/api/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/bakery-api .

# nixpacks writes the Dockerfile of nixpacks Applications; it runs as a
# subprocess of the API like git. Keep the version in step with the tools
# task in services/api/Taskfile.yml.
FROM docker.io/library/debian:trixie-slim AS nixpacks
ARG TARGETARCH
ARG NIXPACKS_VERSION=1.41.0
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN case "$TARGETARCH" in \
      amd64|"") arch=x86_64; sum=0f55de7874507b9cf7502113120bd96f2ab6979f78d10eaf2eb2ade9207b3af6 ;; \
      arm64) arch=aarch64; sum=912bd02dd2bb6f9c3a9ed965fe8a68b4aa318dc7a2546e2eca6f2806a894ba39 ;; \
      *) echo "no nixpacks for $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/nixpacks.tar.gz "https://github.com/railwayapp/nixpacks/releases/download/v${NIXPACKS_VERSION}/nixpacks-v${NIXPACKS_VERSION}-${arch}-unknown-linux-musl.tar.gz" \
 && echo "$sum  /tmp/nixpacks.tar.gz" | sha256sum -c --quiet \
 && tar -xzf /tmp/nixpacks.tar.gz -C /usr/local/bin nixpacks

FROM docker.io/library/debian:trixie-slim
# git: the Deployment worker clones Sources with it; openssh-client for SSH
# Sources. ca-certificates: https clones and image pulls.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/bakery-api /usr/local/bin/bakery-api
COPY --from=nixpacks /usr/local/bin/nixpacks /usr/local/bin/nixpacks
# Goravel writes its logs under storage/ relative to the working directory.
# Backups go to /var/lib/bakery/backups, the bakery-backups volume on a server.
RUN mkdir -p /app/storage && install -d -m 700 /var/lib/bakery/backups
# Root inside a rootless Podman container is the host's bakery user, which
# owns the Podman socket; nothing here runs with more rights than that user.
ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_LEVEL=info \
    LOG_PRINT=true \
    APP_HOST=0.0.0.0 \
    DB_CONNECTION=postgres \
    APP_PORT=4910 \
    MIGRATE_ON_START=true \
    BAKERY_PODMAN_SOCKET=/run/podman/podman.sock \
    BAKERY_BACKUPS_DIR=/var/lib/bakery/backups
EXPOSE 4910
CMD ["bakery-api"]
